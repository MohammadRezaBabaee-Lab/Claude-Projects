# =====================================================================
#  Trading agent configuration (copy to .env and edit; NEVER commit .env)
# =====================================================================

# ---------------------------------------------------------------------
#  Operating mode and safety gate
# ---------------------------------------------------------------------
# paper  -> orders go to the simulated broker (default, safe)
# live   -> orders go to the real broker. Requires ALL of the following:
#           TRADING_MODE=live, TRADING_ENABLED=true,
#           LIVE_TRADING_CONFIRMED=true and
#           LIVE_TRADING_CONFIRMATION_PHRASE set to the exact phrase below.
TRADING_MODE=paper

# Kill switch. false -> no new orders are submitted; monitoring continues.
TRADING_ENABLED=false

# Explicit live-trading confirmation. Both must be set for live orders.
LIVE_TRADING_CONFIRMED=false
LIVE_TRADING_CONFIRMATION_PHRASE=
# The only accepted phrase is:
#   I UNDERSTAND THAT LIVE TRADING RISKS REAL MONEY

# ---------------------------------------------------------------------
#  Broker selection
# ---------------------------------------------------------------------
# simulated -> in-process simulated broker (paper mode)
# alpaca    -> Alpaca Trading API (paper endpoint unless live gate passes)
# avanza    -> UNSUPPORTED: no official API exists; the adapter refuses to start
BROKER=simulated

# Alpaca credentials (create keys in the Alpaca dashboard; use PAPER keys until
# you have completed paper testing). Never commit these.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex

# ---------------------------------------------------------------------
#  Market data
# ---------------------------------------------------------------------
# csv       -> historical CSV files under MARKET_DATA_DIR (backtests, offline paper)
# alpaca    -> Alpaca market data API
# synthetic -> deterministic synthetic prices (tests/examples only)
MARKET_DATA_PROVIDER=csv
MARKET_DATA_DIR=./data/history
# Reject any price older than this many seconds when trading.
MAX_DATA_AGE_SECONDS=900
# Exchange calendar code (exchange_calendars): XNYS = NYSE, XSTO = Nasdaq Stockholm
EXCHANGE_CALENDAR=XNYS
# Timezone used for display and daily rollovers
LOCAL_TIMEZONE=Europe/Stockholm

# ---------------------------------------------------------------------
#  Universe and strategy
# ---------------------------------------------------------------------
UNIVERSE=SPY,QQQ,AAPL,MSFT
STRATEGY=trend_following
STRATEGY_FAST_WINDOW=20
STRATEGY_SLOW_WINDOW=50
STRATEGY_ATR_WINDOW=14
STRATEGY_ATR_STOP_MULTIPLIER=3.0

# ---------------------------------------------------------------------
#  Risk limits (fractions of portfolio value unless stated)
# ---------------------------------------------------------------------
MAX_PORTFOLIO_EXPOSURE=0.70
MAX_POSITION_SIZE=0.10
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.15
MAX_OPEN_POSITIONS=10
CASH_RESERVE=0.10
MAX_ORDER_VALUE=10000
MAX_ORDERS_PER_DAY=20
MAX_ORDERS_PER_SYMBOL_PER_DAY=2
MAX_SECTOR_CONCENTRATION=0.30
STOP_LOSS_PCT=0.08
ABNORMAL_PRICE_MOVE_PCT=0.25

ALLOW_MARGIN=false
ALLOW_DERIVATIVES=false
ALLOW_SHORT_SELLING=false
ALLOW_LEVERAGED_ETFS=false

# Circuit breaker thresholds (within CIRCUIT_BREAKER_WINDOW_SECONDS)
CIRCUIT_BREAKER_MAX_API_ERRORS=5
CIRCUIT_BREAKER_MAX_REJECTED_ORDERS=3
CIRCUIT_BREAKER_MAX_AUTH_FAILURES=2
CIRCUIT_BREAKER_WINDOW_SECONDS=900

# ---------------------------------------------------------------------
#  Simulated broker (paper trading realism)
# ---------------------------------------------------------------------
SIM_INITIAL_CASH=100000
SIM_CURRENCY=USD
SIM_COMMISSION_PER_ORDER=0
SIM_COMMISSION_PCT=0.0005
SIM_SLIPPAGE_BPS=5
SIM_PARTIAL_FILL_PROBABILITY=0.0
SIM_ENFORCE_MARKET_HOURS=true

# ---------------------------------------------------------------------
#  Database
# ---------------------------------------------------------------------
# SQLite for local development; PostgreSQL for production, e.g.
# DATABASE_URL=postgresql+psycopg://trading:password@localhost:5432/trading
DATABASE_URL=sqlite:///./data/trading.db

# ---------------------------------------------------------------------
#  Scheduler / dashboard / notifications / logging
# ---------------------------------------------------------------------
CYCLE_INTERVAL_SECONDS=300
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
NOTIFIER=log
NOTIFICATION_WEBHOOK_URL=
LOG_LEVEL=INFO
LOG_FORMAT=json
